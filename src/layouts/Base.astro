---
import '../styles/global.css';
import { SITE, person, projects, skills } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  bare?: boolean;
}
const {
  title = `${person.name} — ${person.title} · Voice AI, Agents, Web & Mobile`,
  description = `${person.name} is a Budapest-based full-stack & AI engineer shipping voice AI agents, RAG, SSR web apps, Flutter / React Native mobile apps and Cloudflare edge systems. See projects, stack and contact.`,
  path = '/',
  noindex = false,
  bare = false,
} = Astro.props;
const url = new URL(path, SITE).href;
const og = `${SITE}/og.png`;

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE}/#person`,
      name: person.name,
      alternateName: person.nativeName,
      givenName: 'Csaba',
      familyName: 'Rácz',
      jobTitle: person.title,
      description: person.short,
      url: SITE,
      image: og,
      email: `mailto:${person.email}`,
      address: { '@type': 'PostalAddress', addressLocality: 'Budapest', addressCountry: 'HU' },
      nationality: { '@type': 'Country', name: 'Hungary' },
      knowsLanguage: [
        { '@type': 'Language', name: 'Hungarian', alternateName: 'hu' },
        { '@type': 'Language', name: 'English', alternateName: 'en' },
      ],
      worksFor: { '@type': 'Organization', name: person.employer, url: 'https://procats.hu' },
      alumniOf: [
        { '@type': 'EducationalOrganization', name: 'Soter-Line Oktatási Központ' },
        { '@type': 'EducationalOrganization', name: 'Kiskunfélegyházi Szent Benedek PG' },
      ],
      hasCredential: {
        '@type': 'EducationalOccupationalCredential',
        name: 'Junior frontend fejlesztő (state-recognised vocational qualification, EQF 4)',
        credentialCategory: 'vocational qualification',
      },
      knowsAbout: skills.map((s) => s.name),
      sameAs: [person.github],
    },
    {
      '@type': 'ProfilePage',
      '@id': `${SITE}/#profile`,
      url: SITE,
      name: title,
      inLanguage: 'en',
      dateModified: new Date().toISOString().slice(0, 10),
      mainEntity: { '@id': `${SITE}/#person` },
      isPartOf: { '@id': `${SITE}/#website` },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: `${person.name} — ${person.title}`,
      inLanguage: 'en',
      publisher: { '@id': `${SITE}/#person` },
    },
    {
      '@type': 'ItemList',
      '@id': `${SITE}/#work`,
      name: 'Selected projects',
      itemListElement: projects.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          name: p.name,
          description: p.summary,
          creator: { '@id': `${SITE}/#person` },
          keywords: p.stack.join(', '),
          ...(p.links?.[0] ? { url: p.links[0].url } : {}),
        },
      })),
    },
  ],
};
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="en" href={url} />
    <link rel="alternate" hreflang="x-default" href={url} />
    <link rel="alternate" type="text/plain" title="LLM-readable profile" href="/llms.txt" />
    <link rel="author" href="/humans.txt" />
    <meta name="theme-color" content="#06070a" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={`${person.name} · ${person.title}`} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`${person.name} — ${person.title}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="hu_HU" />
    <meta property="profile:first_name" content="Csaba" />
    <meta property="profile:last_name" content="Rácz" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={`${person.name} — ${person.title}`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </head>
  <body>
    {!bare && <a class="skip" href="#main">Skip to content</a>}
    <slot />
  </body>
</html>
