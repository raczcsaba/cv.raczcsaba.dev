---
import { SITE, person, projects, experience, skills, domains, type DomainKey } from '../data/profile';
const featured = projects.filter((p) => p.featured);
const other = projects.filter((p) => !p.featured);
const byDomain = (Object.keys(domains) as DomainKey[]).map((d) => ({
  label: domains[d].label,
  items: skills.filter((s) => s.d === d && s.level >= 3).sort((a, b) => b.level - a.level).map((s) => s.name),
}));
const title = `${person.name} · CV · ${person.title}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={`One-page CV of ${person.name}, ${person.title} in ${person.location}.`} />
  <link rel="canonical" href={`${SITE}/cv/`} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="text/plain" href="/llms.txt" />
  <style is:global>
    @font-face { font-family: Inter; src: url(/fonts/inter-latin-wght-normal.woff2) format('woff2'); font-weight: 100 900; unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: Inter; src: url(/fonts/inter-latin-ext-wght-normal.woff2) format('woff2'); font-weight: 100 900; unicode-range: U+0100-02AF, U+0304, U+0308, U+0329, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }
    @page { size: A4; margin: 12mm 13mm; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { background: #e9ebef; }
    body { font: 9.4pt/1.42 Inter, system-ui, sans-serif; color: #15171c; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .page { width: 210mm; min-height: 297mm; margin: 24px auto; padding: 12mm 13mm; background: #fff; box-shadow: 0 10px 40px #0002; }
    @media print { html { background: #fff; } .page { margin: 0; padding: 0; width: auto; min-height: 0; box-shadow: none; } .noprint { display: none !important; } }
    a { color: inherit; text-decoration: none; }
    header { display: grid; grid-template-columns: 1fr auto; gap: 8mm; align-items: end; padding-bottom: 5mm; border-bottom: 2px solid #15171c; }
    h1 { font-size: 26pt; line-height: 1; letter-spacing: -0.03em; font-weight: 800; }
    .role { margin-top: 2mm; font-size: 11.5pt; font-weight: 600; color: #4b5563; }
    .role b { background: linear-gradient(90deg, #7ac70c, #0aa5c2); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .contact { text-align: right; font-size: 8.6pt; line-height: 1.6; color: #374151; }
    .contact b { color: #15171c; }
    .lede { margin: 4mm 0 1mm; font-size: 10pt; color: #2b2f36; max-width: 165mm; }
    .cols { display: grid; grid-template-columns: 1fr 56mm; gap: 8mm; margin-top: 4mm; }
    h2 { font-size: 8pt; letter-spacing: .16em; text-transform: uppercase; color: #6b7280; margin: 4mm 0 2mm; display: flex; align-items: center; gap: 2mm; }
    h2::after { content: ''; flex: 1; height: 1px; background: #e5e7eb; }
    .item { break-inside: avoid; margin-bottom: 2.6mm; }
    .item h3 { font-size: 9.8pt; font-weight: 700; display: flex; justify-content: space-between; gap: 3mm; }
    .item h3 span { font-weight: 500; color: #6b7280; font-size: 8.4pt; white-space: nowrap; }
    .item .meta { font-size: 8.4pt; color: #4b5563; margin: .3mm 0 .8mm; }
    .item ul { padding-left: 3.6mm; }
    .item li { margin: .3mm 0; }
    .stack { font-size: 7.8pt; color: #4b5563; margin-top: .6mm; }
    .stack i { font-style: normal; display: inline-block; padding: .2mm 1.6mm; border: 1px solid #e5e7eb; border-radius: 99px; margin: .4mm .6mm 0 0; }
    aside .group { margin-bottom: 2.8mm; break-inside: avoid; }
    aside .group b { display: block; font-size: 8.4pt; margin-bottom: .6mm; }
    aside .group p { font-size: 8.2pt; color: #374151; }
    .more li { font-size: 8.4pt; margin-bottom: 1mm; list-style: none; }
    .more li b { font-weight: 650; }
    .bar { position: fixed; top: 14px; right: 14px; display: flex; gap: 8px; }
    .bar a { font: 600 13px Inter, sans-serif; padding: 9px 14px; border-radius: 99px; background: #15171c; color: #c3ff4a; }
    .bar a + a { background: #fff; color: #15171c; border: 1px solid #d1d5db; }
    footer { margin-top: 3mm; font-size: 7.6pt; color: #9ca3af; display: flex; justify-content: space-between; }
  </style>
</head>
<body>
  <nav class="bar noprint"><a href={person.pdf} download>Download PDF</a><a href="/">← Interactive site</a></nav>
  <main class="page">
    <header>
      <div>
        <h1>{person.name}</h1>
        <p class="role"><b>{person.title}</b> · Voice AI · Agents · Web · Mobile · Edge</p>
      </div>
      <div class="contact">
        <b><a href={`mailto:${person.email}`}>{person.email}</a></b><br />
        <a href={SITE}>{SITE.replace('https://', '')}</a> · <a href={person.github}>{person.github.replace('https://', '')}</a><br />
        {person.location} · remote / hybrid<br />
        {person.languages.map((l) => `${l.name} (${l.level.split(' ')[0]})`).join(' · ')}
      </div>
    </header>
    <p class="lede">{person.short} {person.available}.</p>

    <div class="cols">
      <section>
        <h2>Experience</h2>
        {experience.slice(0, 3).map((e) => (
          <div class="item"><h3>{e.title}<span>{e.when}</span></h3><p class="meta">{e.org}</p><p>{e.text}</p></div>
        ))}
        <h2>Selected projects</h2>
        {featured.map((p) => (
          <div class="item">
            <h3>{p.name}<span>{p.period}</span></h3>
            <p class="meta">{p.client} · {p.role}</p>
            <ul>{p.highlights.slice(0, 2).map((h) => <li>{h}</li>)}</ul>
            <p class="stack">{p.stack.slice(0, 7).map((s) => <i>{s}</i>)}</p>
          </div>
        ))}
      </section>
      <aside>
        <h2>Skills</h2>
        {byDomain.map((g) => <div class="group"><b>{g.label}</b><p>{g.items.join(' · ')}</p></div>)}
        <h2>Also built</h2>
        <ul class="more">{other.slice(0, 8).map((p) => <li><b>{p.name}</b>: {p.summary.split('.')[0]}.</li>)}</ul>
        <h2>Education</h2>
        {experience.slice(3).map((e) => <div class="group"><b>{e.title}</b><p>{e.org}</p></div>)}
      </aside>
    </div>
    <footer><span>Interactive version, live AI assistant and all projects: {SITE.replace('https://', '')}</span><span>{new Date().getFullYear()}</span></footer>
  </main>
</body>
</html>
