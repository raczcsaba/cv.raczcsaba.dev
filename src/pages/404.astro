---
import Base from '../layouts/Base.astro';
---
<Base title="404 · Lost in the graph · Csaba Rácz" path="/404" noindex bare>
  <main id="main" style="min-height:100svh;display:grid;place-items:center;text-align:center;padding:2rem">
    <div>
      <p style="font-family:var(--mono, monospace);color:#c3ff4a;letter-spacing:.1em">ERROR 404</p>
      <h1 class="display" style="font-size:clamp(3rem,10vw,7rem);line-height:1;margin:.3em 0">This node<br /><span class="grad">isn't connected.</span></h1>
      <p style="color:#9aa3b2;max-width:36ch;margin:0 auto 2rem">The page you're looking for drifted out of the graph. The rest of the universe is still there.</p>
      <a class="btn btn--primary" href="/">Back to the site →</a>
    </div>
  </main>
</Base>
